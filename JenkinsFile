pipeline {
    agent any

    stages {

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t ayushi-devops-app .'
            }
        }

        stage('Stop Old Container') {
            steps {
                bat 'docker stop ayushi-devops-container 2>nul || exit 0'
                bat 'docker rm ayushi-devops-container 2>nul || exit 0'
            }
        }

        stage('Run Docker Container') {
            steps {
                bat 'docker run -d -p 8001:80 --name ayushi-devops-container ayushi-devops-app'
            }
        }
    }

    post {
        success {
            echo 'CI/CD Pipeline Successful!'
        }
        failure {
            echo 'CI/CD Pipeline Failed!'
        }
    }
}